<odoo>

    <record id="pos_config_view_form_inherit_access_rights" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.access.rights</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="before">
                <setting id="pos_access_rights_setting" string="POS Access Rights" help="Enforce per-employee access rights for POS operations (requires Employee Login).">
                    <field name="enable_access_rights"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
